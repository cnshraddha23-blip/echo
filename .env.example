# Echo Voice Assistant Environment Configuration
# Copy this file to .env and configure your keys

# AI Providers
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ACTIVE_AI_PROVIDER=gemini
# Models: gemini-2.5-flash, gemini-1.5-flash, deepseek-chat, gpt-4o-mini
AI_MODEL_NAME=gemini-2.5-flash

# Server Configuration
HOST=127.0.0.1
PORT=5000
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173,http://127.0.0.1:5000

# Assistant Identity & Voice
ASSISTANT_NAME=Echo
USER_NAME=Shivaraj
DEFAULT_LANGUAGE=en-IN
# Bilingual voice options: en-IN (English India), kn-IN (Kannada India)
ENGLISH_VOICE=en-IN-NeerjaNeural
KANNADA_VOICE=kn-IN-SapnaNeural
SPEECH_RATE=+0%
SPEECH_VOLUME=+0%

# Weather & Integrations (Optional)
OPENWEATHER_API_KEY=
